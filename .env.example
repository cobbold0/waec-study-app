# Public base URL used for canonical links, sitemap and Open Graph (no trailing slash).
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional: Google AdSense publisher ID (e.g. ca-pub-1234567890123456). Ads are hidden when unset.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional: AdSense ad unit slot ID used for display ad placements.
NEXT_PUBLIC_ADSENSE_SLOT=
